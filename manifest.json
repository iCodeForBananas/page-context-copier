{
  "manifest_version": 3,
  "name": "Page Context Copier",
  "version": "1.0.0",
  "description": "One click copies a page's text, structure, accessibility info and metadata as a clean outline to paste into an AI agent.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "offscreen", "contextMenus"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Copy page context for AI (Alt+Shift+C)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Copy page context"
    }
  }
}
